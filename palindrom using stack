#include <iostream>
#include <stack>
#include <string>
using namespace std;

int main()
{
    string str;
    stack<char> s;

    cout << "Enter a string: ";
    cin >> str;

  
    for (int i = 0; i < str.length(); i++)
    {
        s.push(str[i]);
    }

    
    bool isPalindrome = true;

    for (int i = 0; i < str.length(); i++)
    {
        if (str[i] != s.top())
        {
            isPalindrome = false;
            break;
        }
        s.pop();
    }

    if (isPalindrome)
        cout << str << " is a Palindrome";
    else
        cout << str << " is not a Palindrome";

    return 0;
}